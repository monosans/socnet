{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "include": ["socnet"],
  "exclude": ["socnet/static/public"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "checkJs": true,
    "target": "es2023",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  }
}
