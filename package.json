{
  "name": "socnet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild \"./socnet/static/private/**/*\" --bundle --format=esm --loader:.woff2=file --outdir=./socnet/static/public/ --platform=browser --splitting --target=chrome124,edge124,safari17.4,ios17.4,firefox125,opera110",
    "watch": "npm run esbuild-base -- --watch=forever"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "autosize": "6.0.1",
    "bootstrap": "5.3.9",
    "htmx.org": "2.0.11",
    "luxon": "3.7.2",
    "viewerjs": "1.15.2"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node26": "26.0.2",
    "@tsconfig/strictest": "2.0.9",
    "@types/autosize": "4.0.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "stylelint": "18.1.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.1.0",
    "typescript": "7.0.2"
  }
}
