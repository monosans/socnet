{
  "name": "socnet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild \"./socnet/static/private/**/*\" --bundle --format=esm --loader:.ttf=file --loader:.woff2=file --outdir=./socnet/static/public/ --platform=browser --splitting --target=chrome124,edge124,safari17.4,ios17.4,firefox125,opera110",
    "watch": "npm run esbuild-base -- --watch=forever"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "autosize": "6.0.1",
    "bootstrap": "5.3.8",
    "htmx.org": "2.0.11",
    "luxon": "3.7.2",
    "viewerjs": "1.15.2"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/node26": "26.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/autosize": "4.0.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}
