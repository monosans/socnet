{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "dependencyDashboard": false,
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackageNames": ["ruff", "charliermarsh/ruff-pre-commit"],
      "groupName": "ruff"
    },
    {
      "matchPackageNames": ["prettier", "rbubley/mirrors-prettier"],
      "groupName": "prettier"
    },
    { "matchPackageNames": ["djlint", "djlint/djLint"], "groupName": "djlint" },
    {
      "matchPackageNames": ["stylelint", "thibaudcolas/pre-commit-stylelint"],
      "groupName": "stylelint"
    },
    {
      "matchCategories": ["python"],
      "matchPackageNames": ["django-stubs", "django-stubs-ext", "mypy"],
      "groupName": "django-stubs"
    },
    {
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance", "patch", "replacement"],
      "automerge": true
    },
    {
      "matchDepTypes": ["dependency-groups"],
      "matchManagers": ["pep621"],
      "automerge": true
    },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "matchCategories": ["js"],
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Cargo has no cooldown for the transitive dependencies it resolves, so one on the direct dependencies would only delay updates",
      "matchManagers": ["cargo"],
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": ["python", "docker.io/python"],
      "groupName": "python",
      "automerge": false
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
