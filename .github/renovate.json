{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Python version in sync with the Docker image, in the same pull request",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yml$/",
        "/^README\\.md$/",
        "/^mypy\\.ini$/"
      ],
      "matchStrings": [
        "python-version: \"(?<currentValue>\\d+\\.\\d+)\"",
        "- Backend: Python (?<currentValue>\\d+\\.\\d+)",
        "python_version = (?<currentValue>\\d+\\.\\d+)"
      ],
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Same as above, for the version written as py314",
      "managerFilePatterns": ["/^ruff\\.toml$/"],
      "matchStrings": ["target-version = \"py(?<major>\\d)(?<minor>\\d+)\""],
      "currentValueTemplate": "{{{major}}}.{{{minor}}}",
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "target-version = \"py{{{newMajor}}}{{{newMinor}}}\""
    },
    {
      "customType": "regex",
      "description": "The Django version in the docs links, the README and django-upgrade. The same branch topic puts them in the PR that bumps the pin in pyproject.toml",
      "managerFilePatterns": [
        "/\\.py$/",
        "/^\\.env\\.example$/",
        "/^\\.pre-commit-config\\.yaml$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "docs\\.djangoproject\\.com/en/(?<currentValue>\\d+\\.\\d+)/",
        "- --target-version\\n +- \"(?<currentValue>\\d+\\.\\d+)\"",
        ", Django (?<currentValue>\\d+\\.\\d+),"
      ],
      "depNameTemplate": "django",
      "datasourceTemplate": "pypi",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)(?:\\.\\d+)?$"
    }
  ],
  "dependencyDashboard": false,
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "matchPackageNames": ["ruff", "charliermarsh/ruff-pre-commit"], "groupName": "ruff" },
    { "matchPackageNames": ["oxlint", "oxlint-tsgolint"], "groupName": "oxlint" },
    { "matchPackageNames": ["oxfmt", "oxc-project/mirrors-oxfmt"], "groupName": "oxfmt" },
    { "matchPackageNames": ["djlint", "djlint/djLint"], "groupName": "djlint" },
    {
      "description": "A config's major version requires the stylelint it was made for, so neither passes CI without the other",
      "matchPackageNames": ["stylelint", "stylelint-config-*", "thibaudcolas/pre-commit-stylelint"],
      "groupName": "stylelint"
    },
    {
      "matchCategories": ["python"],
      "matchPackageNames": ["django-stubs", "django-stubs-ext", "mypy"],
      "groupName": "django-stubs"
    },
    { "matchCurrentVersion": "!/^0/", "matchUpdateTypes": ["minor"], "automerge": true },
    { "matchUpdateTypes": ["lockFileMaintenance", "patch", "replacement"], "automerge": true },
    { "matchDepTypes": ["dependency-groups"], "matchManagers": ["pep621"], "automerge": true },
    {
      "description": "Every extra but production is for development or tests. The same pin in a dependency group shares its branch, and one update without automerge turns it off for the whole branch",
      "matchDepTypes": ["project.optional-dependencies"],
      "matchManagers": ["pep621"],
      "matchPackageNames": ["!psycopg", "!redis"],
      "automerge": true
    },
    { "matchDepTypes": ["devDependencies"], "matchManagers": ["npm"], "automerge": true },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "description": "A new Node is reviewed by hand, in one pull request with its image and types. Node versioning holds each back until the major version reaches LTS",
      "matchPackageNames": ["node", "docker.io/node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node",
      "automerge": false,
      "prBodyNotes": [
        "Replace `@tsconfig/node<major>` with the one of the new Node by hand: Renovate updates a version, not a package name."
      ]
    },
    {
      "description": "A cooldown would count from the last rebuild of the image tag, which keeps the image out of the Node pull request",
      "matchPackageNames": ["docker.io/node"],
      "minimumReleaseAge": null
    },
    {
      "description": "Cargo has no cooldown for the transitive dependencies it resolves, so one on the direct dependencies would only delay updates",
      "matchManagers": ["cargo"],
      "minimumReleaseAge": null
    },
    {
      "description": "A new Python is reviewed by hand. A cooldown would count from the last rebuild of an image tag, which keeps part of the update out of the PR",
      "matchPackageNames": ["python", "docker.io/python"],
      "groupName": "python",
      "automerge": false,
      "minimumReleaseAge": null
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
